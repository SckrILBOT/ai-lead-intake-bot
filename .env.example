# ===== Обязательные =====
TELEGRAM_BOT_TOKEN=
# Yandex Cloud: API-ключ сервисного аккаунта и ID каталога (folder)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# ===== LLM =====
# Модель из каталога Yandex AI Studio (можно указать полный URI gpt://<каталог>/<модель>)
YANDEX_MODEL=deepseek-v4.1-flash
# responses (по умолчанию) или chat — какой OpenAI-совместимый endpoint использовать.
# Проверить, что работает: python scripts/check_llm.py
YANDEX_API_MODE=responses
HISTORY_LIMIT=15

# ===== Общие =====
TIMEZONE=Europe/Moscow
DATA_DIR=data

# ===== Google Sheets (необязательно; пусто = mock-режим) =====
# Путь к JSON-ключу сервис-аккаунта ИЛИ сам JSON одной строкой
GOOGLE_SERVICE_ACCOUNT_JSON=
SPREADSHEET_ID=
WORKSHEET_NAME=Leads

# ===== SMTP (необязательно; пусто = mock-режим) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
